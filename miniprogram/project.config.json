{
  "description": "活动报名小程序",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": ".workbuddy"
      },
      {
        "type": "folder",
        "value": "node_modules"
      }
    ],
    "include": []
  },
  "setting": {
    "bundle": false,
    "es6": true,
    "enhance": true,
    "minified": true,
    "postcss": true,
    "urlCheck": true,
    "packNpmManually": true,
    "packNpmRelationList": [
      {
        "packageJsonPath": "./package.json",
        "miniprogramNpmDistDir": "./"
      }
    ]
  },
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "activity-organizer",
  "miniprogramRoot": "./"
}
