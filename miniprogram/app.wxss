page {
    min-height: 100%;
    background: #f5f7fa;
    color: #1f2329;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

button {
    border-radius: 16rpx;
}

button::after {
    border: none;
}

.page {
    padding: 32rpx 32rpx 64rpx;
    box-sizing: border-box;
}

.hero {
    display: flex;
    flex-direction: column;
    padding: 40rpx 36rpx;
    border-radius: 28rpx;
    background: #1f3a8a;
    color: #ffffff;
    margin-bottom: 28rpx;
}

.eyebrow {
    font-size: 22rpx;
    letter-spacing: 4rpx;
    opacity: 0.72;
    margin-bottom: 12rpx;
}

.title {
    font-size: 44rpx;
    font-weight: 600;
    line-height: 1.3;
}

.subtitle {
    margin-top: 12rpx;
    font-size: 26rpx;
    line-height: 1.6;
    opacity: 0.82;
}

.section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 32rpx 4rpx 16rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
}

.section-link {
    font-size: 26rpx;
    color: #2f6ae0;
}

.card {
    background: #ffffff;
    border-radius: 24rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 20rpx rgba(31, 58, 138, 0.05);
}

.card-title {
    font-size: 32rpx;
    font-weight: 600;
    line-height: 1.45;
}

.card-meta {
    display: flex;
    flex-direction: column;
    margin-top: 16rpx;
}

.meta-row {
    font-size: 26rpx;
    color: #646a73;
    line-height: 1.8;
}

.state-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 72rpx 32rpx;
    background: #ffffff;
    border-radius: 24rpx;
}

.spinner {
    width: 44rpx;
    height: 44rpx;
    border: 4rpx solid #dfe3ea;
    border-top-color: #2f6ae0;
    border-radius: 50%;
    margin-bottom: 24rpx;
    animation: spin 0.9s linear infinite;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.state-title {
    font-size: 30rpx;
    font-weight: 600;
    margin-bottom: 10rpx;
}

.state-description {
    font-size: 25rpx;
    color: #8a9099;
    line-height: 1.7;
    text-align: center;
}

.primary-button {
    margin-top: 28rpx;
    background: #2f6ae0;
    color: #ffffff;
    font-size: 30rpx;
}

.ghost-button {
    background: #eef2fb;
    color: #2f6ae0;
    font-size: 30rpx;
}

.footer-tip {
    margin-top: 32rpx;
    font-size: 23rpx;
    color: #9aa1ab;
    line-height: 1.8;
    text-align: center;
}
