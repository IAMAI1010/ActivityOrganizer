/* ==========================================================
   主题令牌：浅色（默认）/ 深色（黑灰系）/ 鲜艳（高饱和）
   每个页面根节点加 theme-{{theme}} 类，即可整体换肤。
   ========================================================== */
page {
    --bg: #f5f7fa;
    --surface: #ffffff;
    --surface-soft: #f7f8fa;
    --ink: #1f2329;
    --ink-soft: #3f4650;
    --muted: #8a9099;
    --faint: #9aa1ab;
    --line: #f0f2f5;
    --accent: #2f6ae0;
    --accent-strong: #1f4fbf;
    --accent-soft: #eef2fb;
    --accent-contrast: #ffffff;
    --hero-a: #1f3a8a;
    --hero-b: #2f6ae0;
    --hero-ink: #ffffff;
    --danger: #c0392b;
    --danger-soft: #fdecec;
    --ok: #2f7a4a;
    --ok-soft: #e7f6ec;
    --chip-bg: #f2f5fb;
    --avatar-bg: #d7e2f7;
    --shadow: rgba(31, 58, 138, 0.06);

    min-height: 100%;
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.theme-dark {
    --bg: #101113;
    --surface: #17181b;
    --surface-soft: #1d1f22;
    --ink: #eceef0;
    --ink-soft: #c6cad0;
    --muted: #9096a0;
    --faint: #7f858f;
    --line: #2a2d31;
    --accent: #e2b566;
    --accent-strong: #efc57e;
    --accent-soft: rgba(226, 181, 102, 0.16);
    --accent-contrast: #241a08;
    --hero-a: #1c1e21;
    --hero-b: #26282c;
    --hero-ink: #f4f1ea;
    --danger: #e58074;
    --danger-soft: rgba(229, 128, 116, 0.16);
    --ok: #8fd0a8;
    --ok-soft: rgba(143, 208, 168, 0.14);
    --chip-bg: #23262b;
    --avatar-bg: #2c3036;
    --shadow: rgba(0, 0, 0, 0.5);
}

.theme-vivid {
    --bg: #fff7ef;
    --surface: #ffffff;
    --surface-soft: #fff1e7;
    --ink: #251b22;
    --ink-soft: #4a3b44;
    --muted: #8f7d86;
    --faint: #a08e97;
    --line: #ffdcc6;
    --accent: #ff4b12;
    --accent-strong: #e63e08;
    --accent-soft: #ffe6db;
    --accent-contrast: #ffffff;
    --hero-a: #ff4b12;
    --hero-b: #ff8a3d;
    --hero-ink: #ffffff;
    --danger: #e5002b;
    --danger-soft: #ffe1e6;
    --ok: #0f9d58;
    --ok-soft: #e3f8ea;
    --chip-bg: #fff1e7;
    --avatar-bg: #ffd6c2;
    --shadow: rgba(179, 57, 8, 0.16);
}

button {
    border-radius: 16rpx;
}

button::after {
    border: none;
}

.page {
    min-height: 100vh;
    padding: 32rpx 32rpx 64rpx;
    box-sizing: border-box;
    background: var(--bg);
    color: var(--ink);
}

.hero {
    display: flex;
    flex-direction: column;
    padding: 40rpx 36rpx;
    border-radius: 28rpx;
    background: linear-gradient(135deg, var(--hero-a), var(--hero-b));
    color: var(--hero-ink);
    margin-bottom: 28rpx;
}

.eyebrow {
    font-size: 22rpx;
    letter-spacing: 4rpx;
    opacity: 0.78;
    margin-bottom: 12rpx;
}

.title {
    font-size: 44rpx;
    font-weight: 600;
    line-height: 1.3;
}

.subtitle {
    margin-top: 12rpx;
    font-size: 26rpx;
    line-height: 1.6;
    opacity: 0.86;
}

.section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 32rpx 4rpx 16rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
    color: var(--ink);
}

.section-link {
    font-size: 26rpx;
    color: var(--accent);
}

.card {
    background: var(--surface);
    border: 2rpx solid var(--line);
    border-radius: 24rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 20rpx var(--shadow);
}

.card-title {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink);
}

.card-meta {
    display: flex;
    flex-direction: column;
    margin-top: 16rpx;
}

.meta-row {
    font-size: 26rpx;
    color: var(--muted);
    line-height: 1.8;
}

.state-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 72rpx 32rpx;
    background: var(--surface);
    border: 2rpx solid var(--line);
    border-radius: 24rpx;
}

.spinner {
    width: 44rpx;
    height: 44rpx;
    border: 4rpx solid var(--line);
    border-top-color: var(--accent);
    border-radius: 50%;
    margin-bottom: 24rpx;
    animation: spin 0.9s linear infinite;
}

@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.state-title {
    font-size: 30rpx;
    font-weight: 600;
    margin-bottom: 10rpx;
    color: var(--ink);
}

.state-description {
    font-size: 25rpx;
    color: var(--muted);
    line-height: 1.7;
    text-align: center;
}

.primary-button {
    margin-top: 28rpx;
    background: var(--accent);
    color: var(--accent-contrast);
    font-size: 30rpx;
}

.primary-button[disabled] {
    background: var(--accent);
    color: var(--accent-contrast);
    opacity: 0.55;
}

.ghost-button {
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 30rpx;
}

.footer-tip {
    margin-top: 32rpx;
    font-size: 23rpx;
    color: var(--faint);
    line-height: 1.8;
    text-align: center;
}

.theme-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22rpx 28rpx;
    margin-bottom: 24rpx;
    border-radius: 24rpx;
    background: var(--surface);
    border: 2rpx solid var(--line);
}

.theme-bar-label {
    font-size: 26rpx;
    color: var(--muted);
}

.theme-options {
    display: flex;
    align-items: center;
    padding: 4rpx;
    border-radius: 999rpx;
    background: var(--surface-soft);
}

.theme-option {
    padding: 8rpx 22rpx;
    border-radius: 999rpx;
    font-size: 24rpx;
    color: var(--muted);
}

.theme-option.active {
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-weight: 600;
}
