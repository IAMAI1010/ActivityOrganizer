.entry-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.entry-main {
    display: flex;
    flex-direction: column;
}

.entry-label {
    font-size: 28rpx;
    color: var(--muted);
}

.entry-value {
    margin-top: 8rpx;
    font-size: 36rpx;
    font-weight: 600;
    color: var(--ink);
}

.entry-arrow {
    font-size: 44rpx;
    color: var(--faint);
}

.activity-card {
    display: flex;
    flex-direction: column;
}

.state-icon {
    font-size: 52rpx;
    color: var(--accent);
    margin-bottom: 12rpx;
}
