.form-header {
    display: flex;
    flex-direction: column;
    padding: 8rpx 4rpx 24rpx;
}

.form-eyebrow {
    font-size: 23rpx;
    letter-spacing: 3rpx;
    color: var(--faint);
}

.form-title {
    margin-top: 10rpx;
    font-size: 40rpx;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
}

.error-banner {
    padding: 22rpx 26rpx;
    margin-bottom: 20rpx;
    border-radius: 18rpx;
    background: var(--danger-soft);
    color: var(--danger);
    font-size: 25rpx;
    line-height: 1.6;
}

.field {
    display: flex;
    flex-direction: column;
    padding: 20rpx 0;
    border-bottom: 2rpx solid var(--line);
}

.field:last-child {
    border-bottom: none;
}

.field-label {
    font-size: 27rpx;
    color: var(--ink-soft);
    margin-bottom: 14rpx;
}

.required {
    color: var(--danger);
    margin-left: 6rpx;
}

.field-input {
    height: 76rpx;
    padding: 0 22rpx;
    border-radius: 14rpx;
    border: 2rpx solid var(--line);
    background: var(--surface-soft);
    color: var(--ink);
    font-size: 28rpx;
    line-height: 72rpx;
    box-sizing: border-box;
}

.field-input-error {
    border-color: var(--danger);
    background: var(--danger-soft);
}

.field-textarea {
    width: 100%;
    height: 160rpx;
    padding: 18rpx 22rpx;
    box-sizing: border-box;
    border-radius: 14rpx;
    border: 2rpx solid var(--line);
    background: var(--surface-soft);
    color: var(--ink);
    font-size: 28rpx;
}

.picker-value {
    display: flex;
    align-items: center;
    color: var(--ink-soft);
}

.field-hint {
    margin-top: 10rpx;
    font-size: 22rpx;
    color: var(--faint);
}

.submit-button {
    margin-top: 20rpx;
    width: 100% !important;
    height: 96rpx;
    line-height: 96rpx;
    font-size: 32rpx;
    font-weight: 600;
    border-radius: 20rpx;
}

.state-icon {
    font-size: 52rpx;
    color: var(--accent);
    margin-bottom: 12rpx;
}
