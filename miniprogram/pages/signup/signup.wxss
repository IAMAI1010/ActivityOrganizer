.form-header {
    display: flex;
    flex-direction: column;
    padding: 8rpx 4rpx 24rpx;
}

.form-eyebrow {
    font-size: 23rpx;
    letter-spacing: 3rpx;
    color: #8a9099;
}

.form-title {
    margin-top: 10rpx;
    font-size: 40rpx;
    font-weight: 600;
    line-height: 1.4;
}

.error-banner {
    padding: 22rpx 26rpx;
    margin-bottom: 20rpx;
    border-radius: 18rpx;
    background: #fdecec;
    color: #c0392b;
    font-size: 25rpx;
    line-height: 1.6;
}

.field {
    display: flex;
    flex-direction: column;
    padding: 20rpx 0;
    border-bottom: 2rpx solid #f0f2f5;
}

.field:last-child {
    border-bottom: none;
}

.field-label {
    font-size: 27rpx;
    color: #3f4650;
    margin-bottom: 14rpx;
}

.required {
    color: #d64545;
    margin-left: 6rpx;
}

.field-input {
    height: 76rpx;
    padding: 0 22rpx;
    border-radius: 14rpx;
    background: #f7f8fa;
    font-size: 28rpx;
    line-height: 76rpx;
}

.field-input-error {
    background: #fdecec;
}

.field-textarea {
    width: 100%;
    height: 160rpx;
    padding: 18rpx 22rpx;
    box-sizing: border-box;
    border-radius: 14rpx;
    background: #f7f8fa;
    font-size: 28rpx;
}

.picker-value {
    display: flex;
    align-items: center;
    color: #3f4650;
}

.field-hint {
    margin-top: 10rpx;
    font-size: 22rpx;
    color: #9aa1ab;
}

.submit-button {
    margin-top: 20rpx;
}

.state-icon {
    font-size: 52rpx;
    color: #2f6ae0;
    margin-bottom: 12rpx;
}
