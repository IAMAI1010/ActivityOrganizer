<view class="page theme-{{theme}}">
    <view class="state-card" wx:if="{{viewState === 'loading'}}">
        <view class="spinner"></view>
        <text class="state-title">正在加载报名表</text>
    </view>

    <view class="state-card" wx:elif="{{viewState === 'error'}}">
        <text class="state-icon">!</text>
        <text class="state-title">无法打开报名表</text>
        <text class="state-description">{{errorMessage}}</text>
        <button class="primary-button" bindtap="handleRetry">重新加载</button>
    </view>

    <block wx:else>
        <view class="form-header">
            <text class="form-eyebrow">报名参加</text>
            <text class="form-title">{{activityTitle}}</text>
        </view>

        <view class="error-banner" wx:if="{{errorMessage}}">{{errorMessage}}</view>

        <view class="card">
            <view class="field">
                <text class="field-label">微信昵称<text class="required">*</text></text>
                <input
                    class="field-input {{errorKey === 'nickname' ? 'field-input-error' : ''}}"
                    type="nickname"
                    placeholder="点击此处，可一键带入微信昵称"
                    value="{{nickname}}"
                    bindinput="onNicknameInput"
                />
                <text class="field-hint">好友点开活动卡时使用，显示在报名名单中。</text>
            </view>

            <view class="field">
                <text class="field-label">姓名</text>
                <input class="field-input" placeholder="选填" value="{{name}}" bindinput="onNameInput" />
            </view>

            <view class="field">
                <text class="field-label">手机号</text>
                <input
                    class="field-input {{errorKey === 'phone' ? 'field-input-error' : ''}}"
                    type="number"
                    maxlength="11"
                    placeholder="选填，方便组织者联系你"
                    value="{{phone}}"
                    bindinput="onPhoneInput"
                />
            </view>

            <view class="field" wx:for="{{fields}}" wx:key="key">
                <text class="field-label">{{item.label}}<text class="required" wx:if="{{item.required}}">*</text></text>
                <input
                    wx:if="{{item.type === 'text'}}"
                    class="field-input {{errorKey === item.key ? 'field-input-error' : ''}}"
                    placeholder="请输入"
                    value="{{item.value}}"
                    data-index="{{index}}"
                    bindinput="onFieldInput"
                />
                <textarea
                    wx:elif="{{item.type === 'textarea'}}"
                    class="field-textarea {{errorKey === item.key ? 'field-input-error' : ''}}"
                    placeholder="请输入"
                    value="{{item.value}}"
                    data-index="{{index}}"
                    bindinput="onFieldInput"
                ></textarea>
                <picker
                    wx:else
                    mode="selector"
                    range="{{item.options}}"
                    value="{{item.pickerIndex}}"
                    data-index="{{index}}"
                    bindchange="onFieldPicker"
                >
                    <view class="field-input picker-value">{{item.pickerText || '请选择'}}</view>
                </picker>
            </view>
        </view>

        <button class="primary-button submit-button" bindtap="submitForm" loading="{{submitting}}" disabled="{{submitting}}">
            {{submitting ? '提交中' : '确认报名'}}
        </button>

        <text class="footer-tip">提交后，组织者可以看到你的昵称和填写的信息。</text>
    </block>
</view>
