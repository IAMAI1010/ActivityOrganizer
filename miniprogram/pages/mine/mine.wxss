.page-head {
    display: flex;
    flex-direction: column;
    padding: 8rpx 4rpx 28rpx;
}

.page-title {
    font-size: 40rpx;
    font-weight: 600;
    color: var(--ink);
}

.page-subtitle {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: var(--muted);
    line-height: 1.7;
}

.state-icon {
    font-size: 52rpx;
    color: var(--accent);
    margin-bottom: 12rpx;
}

.back-button {
    margin-top: 8rpx;
}
