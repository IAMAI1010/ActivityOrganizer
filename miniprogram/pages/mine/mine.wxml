<view class="page">
    <view class="page-head">
        <text class="page-title">我报名的活动</text>
        <text class="page-subtitle">记录保存在这台手机上，换设备后可从活动卡片重新打开。</text>
    </view>

    <view class="state-card" wx:if="{{viewState === 'empty'}}">
        <text class="state-icon">○</text>
        <text class="state-title">还没有报名记录</text>
        <text class="state-description">点开好友分享的活动卡片完成报名后，会出现在这里。</text>
        <button class="primary-button" bindtap="goHome">去看活动</button>
    </view>

    <block wx:else>
        <view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
            <text class="card-title">{{item.title}}</text>
            <view class="card-meta">
                <text class="meta-row" wx:if="{{item.timeText}}">{{item.timeText}}</text>
                <text class="meta-row" wx:if="{{item.location}}">{{item.location}}</text>
            </view>
        </view>
        <button class="ghost-button back-button" bindtap="goHome">返回活动列表</button>
    </block>
</view>
