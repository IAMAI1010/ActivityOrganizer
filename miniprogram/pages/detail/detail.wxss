.cover {
    width: 100%;
    height: 320rpx;
    border-radius: 24rpx;
    overflow: hidden;
    margin-bottom: 24rpx;
    background: var(--surface-soft);
    border: 2rpx solid var(--line);
}

.cover-image {
    width: 100%;
    height: 100%;
}

.state-icon {
    font-size: 52rpx;
    color: var(--accent);
    margin-bottom: 12rpx;
}

.tip-banner {
    padding: 24rpx 28rpx;
    margin-bottom: 24rpx;
    border-radius: 20rpx;
    background: var(--ok-soft);
    color: var(--ok);
    font-size: 27rpx;
}

.block-title {
    font-size: 30rpx;
    font-weight: 600;
    color: var(--ink);
}

.description {
    display: block;
    margin-top: 16rpx;
    font-size: 27rpx;
    line-height: 1.8;
    color: var(--ink-soft);
    white-space: pre-wrap;
}

.signup-list {
    display: flex;
    flex-wrap: wrap;
    margin-top: 20rpx;
}

.signup-chip {
    display: flex;
    align-items: center;
    padding: 10rpx 20rpx 10rpx 12rpx;
    margin: 0 16rpx 16rpx 0;
    border-radius: 999rpx;
    background: var(--chip-bg);
}

.avatar {
    width: 44rpx;
    height: 44rpx;
    border-radius: 50%;
    background: var(--avatar-bg);
}

.avatar-text {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-strong);
    font-size: 22rpx;
    font-weight: 600;
}

.chip-name {
    margin-left: 12rpx;
    font-size: 24rpx;
    color: var(--ink-soft);
}

.signed-badge {
    padding: 22rpx 28rpx;
    border-radius: 20rpx;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 27rpx;
    text-align: center;
    margin-bottom: 20rpx;
}

.action-bar {
    display: flex;
    margin-top: 8rpx;
}

.action-main {
    flex: 2;
    margin-top: 0;
}

.action-share {
    flex: 1;
    margin-left: 20rpx;
}
