.cover {
    width: 100%;
    height: 320rpx;
    border-radius: 24rpx;
    overflow: hidden;
    margin-bottom: 24rpx;
    background: var(--surface-soft);
    border: 2rpx solid var(--line);
}

/* 海报封面：与网页端共用同一份配方，纯样式渲染，不依赖图片 */
.poster {
    position: relative;
    width: 100%;
    height: 720rpx;
    border-radius: 28rpx;
    overflow: hidden;
    margin-bottom: 24rpx;
    padding: 52rpx 44rpx;
    box-sizing: border-box;
}

.poster-shape {
    position: absolute;
}

.poster-body {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
}

.poster-badge {
    align-self: flex-start;
    font-size: 22rpx;
    line-height: 1;
    padding: 14rpx 24rpx;
    border-radius: 999rpx;
}

.poster-headline {
    display: block;
    font-size: 60rpx;
    font-weight: 700;
    line-height: 1.28;
    letter-spacing: 1rpx;
}

.poster-rule {
    width: 96rpx;
    height: 8rpx;
    border-radius: 999rpx;
    margin: 26rpx 0 20rpx;
}

.poster-subhead {
    display: block;
    font-size: 26rpx;
    line-height: 1.55;
}

.poster-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16rpx;
}

.poster-org {
    font-size: 22rpx;
}

.poster-chip {
    display: flex;
    align-items: center;
    font-size: 24rpx;
    font-weight: 600;
    padding: 16rpx 30rpx;
    border-radius: 999rpx;
}

.poster-chip-text {
    font-size: 24rpx;
}

.poster-chip-icon {
    width: 24rpx;
    height: 24rpx;
    margin-right: 10rpx;
}

.cover-image {
    width: 100%;
    height: 100%;
}

.state-icon {
    font-size: 52rpx;
    color: var(--accent);
    margin-bottom: 12rpx;
}

.tip-banner {
    padding: 24rpx 28rpx;
    margin-bottom: 24rpx;
    border-radius: 20rpx;
    background: var(--ok-soft);
    color: var(--ok);
    font-size: 27rpx;
}

.block-title {
    font-size: 30rpx;
    font-weight: 600;
    color: var(--ink);
}

.description {
    display: block;
    margin-top: 16rpx;
    font-size: 27rpx;
    line-height: 1.8;
    color: var(--ink-soft);
    white-space: pre-wrap;
}

.signup-list {
    display: flex;
    flex-wrap: wrap;
    margin-top: 20rpx;
}

.signup-chip {
    display: flex;
    align-items: center;
    padding: 10rpx 20rpx 10rpx 12rpx;
    margin: 0 16rpx 16rpx 0;
    border-radius: 999rpx;
    background: var(--chip-bg);
}

.avatar {
    width: 44rpx;
    height: 44rpx;
    border-radius: 50%;
    background: var(--avatar-bg);
}

.avatar-text {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-strong);
    font-size: 22rpx;
    font-weight: 600;
}

.chip-name {
    margin-left: 12rpx;
    font-size: 24rpx;
    color: var(--ink-soft);
}

.signed-badge {
    padding: 22rpx 28rpx;
    border-radius: 20rpx;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 27rpx;
    text-align: center;
    margin-bottom: 20rpx;
}

/* 底部操作区：主按钮独占一行居中加高，分享按钮在下一行居中。
   微信 button 内置了固定宽度，必须用 !important 才能覆盖。 */
.action-bar {
    display: flex;
    justify-content: center;
    margin-top: 8rpx;
}

.action-main {
    flex: none;
    width: 456rpx !important;
    height: 96rpx;
    line-height: 96rpx;
    font-size: 32rpx;
    font-weight: 600;
    border-radius: 20rpx;
    margin-top: 0;
}

.action-sub {
    display: flex;
    justify-content: center;
    margin-top: 24rpx;
}

.action-share {
    flex: none;
    width: 456rpx !important;
    height: 88rpx;
    font-size: 28rpx;
    border-radius: 20rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* 通用分享图标（托盘 + 上箭头），颜色跟随文字 */
.icon-share {
    position: relative;
    width: 30rpx;
    height: 36rpx;
    margin-right: 12rpx;
    flex: none;
}

.icon-share-box {
    position: absolute;
    bottom: 0;
    left: 2rpx;
    right: 2rpx;
    height: 22rpx;
    border: 3rpx solid currentColor;
    border-top: none;
    border-radius: 0 0 6rpx 6rpx;
    box-sizing: border-box;
}

.icon-share-stem {
    position: absolute;
    left: 50%;
    margin-left: -1.5rpx;
    top: 7rpx;
    width: 3rpx;
    height: 11rpx;
    border-radius: 2rpx;
    background: currentColor;
}

.icon-share-tip {
    position: absolute;
    left: 50%;
    margin-left: -7rpx;
    top: 0;
    width: 14rpx;
    height: 14rpx;
    box-sizing: border-box;
    border-top: 3rpx solid currentColor;
    border-left: 3rpx solid currentColor;
    border-top-left-radius: 2rpx;
    transform: rotate(45deg);
}

/* 通用扫码图标（四角括号 + 扫描线），颜色跟随文字 */
.icon-scan {
    position: relative;
    width: 24rpx;
    height: 24rpx;
    flex: none;
}

.scan-corner {
    position: absolute;
    width: 9rpx;
    height: 9rpx;
}

.scan-corner.tl {
    left: 0;
    top: 0;
    border-left: 3rpx solid currentColor;
    border-top: 3rpx solid currentColor;
    border-top-left-radius: 4rpx;
}

.scan-corner.tr {
    right: 0;
    top: 0;
    border-right: 3rpx solid currentColor;
    border-top: 3rpx solid currentColor;
    border-top-right-radius: 4rpx;
}

.scan-corner.bl {
    left: 0;
    bottom: 0;
    border-left: 3rpx solid currentColor;
    border-bottom: 3rpx solid currentColor;
    border-bottom-left-radius: 4rpx;
}

.scan-corner.br {
    right: 0;
    bottom: 0;
    border-right: 3rpx solid currentColor;
    border-bottom: 3rpx solid currentColor;
    border-bottom-right-radius: 4rpx;
}

.scan-line {
    position: absolute;
    left: 4rpx;
    right: 4rpx;
    top: 50%;
    margin-top: -2rpx;
    height: 4rpx;
    border-radius: 4rpx;
    background: currentColor;
}

.meta-place {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.meta-place-text {
    flex: 1;
    min-width: 0;
    font-size: 26rpx;
    color: var(--muted);
    line-height: 1.8;
}

.meta-place-nav {
    flex: none;
    padding: 2rpx 16rpx;
    border-radius: 999rpx;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 22rpx;
}
