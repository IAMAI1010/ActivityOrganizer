.cover {
    width: 100%;
    height: 320rpx;
    border-radius: 24rpx;
    overflow: hidden;
    margin-bottom: 24rpx;
    background: #e8ecf4;
}

.cover-image {
    width: 100%;
    height: 100%;
}

.state-icon {
    font-size: 52rpx;
    color: #2f6ae0;
    margin-bottom: 12rpx;
}

.tip-banner {
    padding: 24rpx 28rpx;
    margin-bottom: 24rpx;
    border-radius: 20rpx;
    background: #e7f6ec;
    color: #2f7a4a;
    font-size: 27rpx;
}

.block-title {
    font-size: 30rpx;
    font-weight: 600;
}

.description {
    display: block;
    margin-top: 16rpx;
    font-size: 27rpx;
    line-height: 1.8;
    color: #3f4650;
    white-space: pre-wrap;
}

.signup-list {
    display: flex;
    flex-wrap: wrap;
    margin-top: 20rpx;
}

.signup-chip {
    display: flex;
    align-items: center;
    padding: 10rpx 20rpx 10rpx 12rpx;
    margin: 0 16rpx 16rpx 0;
    border-radius: 999rpx;
    background: #f2f5fb;
}

.avatar {
    width: 44rpx;
    height: 44rpx;
    border-radius: 50%;
    background: #d7e2f7;
}

.avatar-text {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #2f6ae0;
    font-size: 22rpx;
    font-weight: 600;
}

.chip-name {
    margin-left: 12rpx;
    font-size: 24rpx;
    color: #3f4650;
}

.signed-badge {
    padding: 22rpx 28rpx;
    border-radius: 20rpx;
    background: #eef2fb;
    color: #2f6ae0;
    font-size: 27rpx;
    text-align: center;
    margin-bottom: 20rpx;
}

.action-bar {
    display: flex;
    margin-top: 8rpx;
}

.action-main {
    flex: 2;
    margin-top: 0;
}

.action-share {
    flex: 1;
    margin-left: 20rpx;
}
